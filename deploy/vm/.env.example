# ============================================================
#  bob-mind configuration
#  Copy this file to `.env` and fill it in:
#      cp .env.example .env
#      nano .env
#
#  NEVER commit the real .env — it holds your bot token.
# ============================================================

# ------------------------------------------------------------
#  REQUIRED — Telegram
# ------------------------------------------------------------

# Bot token from @BotFather in Telegram (send /newbot).
TELEGRAM_BOT_TOKEN=

# Your NUMERIC Telegram user id, from @userinfobot. This is a number
# like 123456789 — NOT your @username. Comma-separate several ids.
#
# IMPORTANT: if you leave this empty, Hermes DENIES EVERYONE by default
# and your bot will silently ignore every message you send it.
TELEGRAM_ALLOWED_USERS=


# ------------------------------------------------------------
#  MODEL — the defaults below already work. You can skip this
#  whole section and the bot will still answer.
# ------------------------------------------------------------
#
# With nothing set, the stack uses the built-in keyless OmniRouter with
# the model "auto", which picks the healthiest free provider and fails
# over automatically. No API key, no signup, no cost.

# HERMES_PROVIDER=omnirouter
# HERMES_MODEL=auto

# Prefer a specific free model? Uncomment and pick one:
#   auto                    best healthy provider, with failover
#   qwen/qwen3.8-max        Qwen
#   gemini/gemini-3.6-flash Gemini
#   glm/glm-5.3             GLM
#   oc/big-pickle           OpenCode Zen (keyless)
# HERMES_MODEL=gemini/gemini-3.6-flash


# ------------------------------------------------------------
#  OPTIONAL — use 9Router instead of OmniRouter
# ------------------------------------------------------------
# 9Router gives you paid/other models, but you must first open its
# dashboard (http://YOUR-IP:7860/), log in with ROUTER_INITIAL_PASSWORD
# below, and create an API key by hand. Then set all three values.
#
# ROUTER_INITIAL_PASSWORD=changeme
# HERMES_PROVIDER=ninerouter
# HERMES_MODEL=gemini-2.5-flash
# NINEROUTER_API_KEY=


# ------------------------------------------------------------
#  OPTIONAL — agent web dashboard at /hermes/
# ------------------------------------------------------------
# Disabled unless BOTH username and password are set.
#
# PUBLIC_URL=http://YOUR-SERVER-IP:7860
# DASHBOARD_USERNAME=admin
# DASHBOARD_PASSWORD=


# ------------------------------------------------------------
#  OPTIONAL — agent as an OpenAI-compatible API at /hermes-api/v1
# ------------------------------------------------------------
# HERMES_API_KEY=


# ------------------------------------------------------------
#  OPTIONAL — hourly backup of /opt/data to a PRIVATE HF dataset
# ------------------------------------------------------------
# Datasets are free (unlike Docker Spaces). Leave both empty to skip.
# BACKUP_REPO=youruser/bob-mind-backup
# HF_TOKEN=


# ------------------------------------------------------------
#  OPTIONAL — misc
# ------------------------------------------------------------
# HERMES_TIMEZONE=UTC
# OMNI_ENABLED=true

# Host port for the dashboards (default 7860).
# PUBLIC_PORT=7860

# Container memory cap (default 8g).
# MEMORY_LIMIT=8g
